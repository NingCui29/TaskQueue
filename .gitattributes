# 自动识别文本文件并规范化换行。
* text=auto

# Linux 持续集成入口使用 LF 换行。
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# 统一源码、文档和构建配置的换行。
.gitattributes text eol=lf
.gitignore text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 二进制构建输入和发布包不进行换行转换。
*.jar binary
*.aar binary
*.apk binary
*.aab binary
